# ===== AISOC 环境变量示例（复制为 .env 并填写；.env 永不入库） =====

# --- 运行环境: dev | test | staging | prod（prod 缺少密钥将拒绝启动） ---
ENV=dev

# --- 数据库（本地开发可用 sqlite；生产必须 PostgreSQL） ---
DATABASE_URL=sqlite+aiosqlite:///./aisoc.db
# DATABASE_URL=postgresql+psycopg://aisoc:CHANGE_ME@localhost:5432/aisoc

# --- Redis（本地开发内联模式可不配） ---
REDIS_URL=redis://localhost:6379/0

# --- 密钥（prod 必填；下方命令可生成） ---
# python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=
BOOTSTRAP_ADMIN_PASSWORD=

# --- 任务模式（dev/test 内联执行免 broker；生产必须 false 走 Celery） ---
TASK_INLINE=true

# --- AI 模型路由（purpose -> provider:model 降级链） ---
LLM_ROUTING={"triage":["deepseek:deepseek-chat"],"embed":["deepseek:deepseek-chat"],"chat":["deepseek:deepseek-chat"]}

# 任选一家或多家；密钥经 Fernet 加密落库，日志强制脱敏
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
# 私有化选项（数据不出域）：LLM_ROUTING 使用 ollama:模型名
OLLAMA_BASE_URL=

# --- 开发示例数据 ---
# python -m app.db.demo_data  （需先 alembic upgrade head + seed）
